[Unit]
Description=IoTBench native Telnet maintenance login (explicit start only)
ConditionPathExists=/run/iotbench-telnet-test

[Service]
Type=simple
ExecStart=@SBINDIR@/telnetd -F -b 127.0.0.1:2323 -l /bin/login
Restart=no
LimitCORE=0
PrivateNetwork=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX
# login changes PTY ownership and switches to the authenticated account.
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_SETUID CAP_SETGID
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
