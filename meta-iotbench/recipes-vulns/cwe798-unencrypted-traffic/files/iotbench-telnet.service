[Unit]
Description=IoTBench synthetic plaintext Telnet fixture (CWE-798/287/276)
ConditionPathExists=/run/iotbench-telnet-test

[Service]
Type=simple
User=nobody
Group=nogroup
ExecStart=@BINDIR@/fixture-telnet --fixture-test
Restart=no
RuntimeMaxSec=30
LimitCORE=0
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET
CapabilityBoundingSet=
UMask=0077
