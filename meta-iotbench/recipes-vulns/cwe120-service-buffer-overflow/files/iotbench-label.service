[Unit]
Description=Intentionally insecure synthetic local label fixture (CWE-120)
ConditionPathExists=/etc/iotbench/cwe120-fixture-enabled

[Service]
Type=simple
User=nobody
Group=nogroup
RuntimeDirectory=iotbench-label
RuntimeDirectoryMode=0700
Environment=IOTBENCH_CWE120_FIXTURE=1
ExecStart=/usr/bin/fixture-label-service --fixture-test
Restart=no
RuntimeMaxSec=15
LimitCORE=0
LimitCPU=5
MemoryMax=64M
TasksMax=4
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
